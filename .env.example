# .env に写して、この機械に合わせて書く。.env はコミットしない。

# データベースのパスワード。空のままでは起動しない。`;` は使えない
POSTGRES_PASSWORD=

# データベースのデータを置くホスト側のディレクトリ
CARINA_DB_DIR=

# 録画を書くホスト側のディレクトリ。移行で録画を移すなら、移行元と同じマウントの下に置く
CARINA_RECORDINGS_DIR=

# エンコード済みファイルを書くホスト側のディレクトリ。ライブラリと一緒に増える
CARINA_ENCODES_DIR=

# OIDC の client secret を暗号化する鍵を置くホスト側のディレクトリ。データベースとは別に残す
CARINA_KEYS_DIR=

# ブラウザからこのサーバに届くアドレス (https://tv.example.com など)。ID プロバイダに登録する redirect URI の元になる
CARINA_PUBLIC_ORIGIN=

# Caddy が開くサイトのアドレス。公開のドメイン (tv.example.com) なら https で開き証明書を取る。LAN だけなら :80 のまま
PYXIS_SITE_ADDRESS=:80

# ホスト側で開く http と https のポート。80 と 443 がほかに使われているなら別の番号にする
PYXIS_HTTP_PORT=80
PYXIS_HTTPS_PORT=443

# 録画をあとからエンコードするときの変換器。Software か Vaapi (GPU を渡したとき)
CARINA_ENCODINGS_PREFER=Software

# ライブと録画再生をその場で変換するときの変換器。Software か Vaapi (GPU を渡したとき)
CARINA_TRANSCODING_PREFER=Software

# VAAPI で使う GPU の描画ノード
CARINA_RENDER_NODE=/dev/dri/renderD128
