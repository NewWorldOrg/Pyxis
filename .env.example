# .env にコピーして、この機械に合わせて書き換える。.env はコミットしない。

# データベースのパスワード。空のままでは起動しない。`;` は使えない
POSTGRES_PASSWORD=

# データベースのデータを置くホスト側のディレクトリ
CARINA_DB_DIR=

# 録画を書くホスト側のディレクトリ。移行で録画を移すなら、移行元と同じマウントの下に置く
CARINA_RECORDINGS_DIR=

# エンコード済みファイルを書くホスト側のディレクトリ。ライブラリと一緒に増える
CARINA_ENCODES_DIR=

# OIDC の client secret や通知の送り先を暗号化する鍵 (ASP.NET Core Data Protection) と、Web Push の署名に使う鍵を置くホスト側のディレクトリ。データベースとは別にバックアップする
CARINA_KEYS_DIR=

# ブラウザから見たこのサーバのアドレス (https://tv.example.com など)。ID プロバイダに登録する redirect URI の元になる
CARINA_PUBLIC_ORIGIN=

# Caddy が待ち受けるサイトのアドレス。公開のドメイン (tv.example.com) なら証明書を取得して https で待ち受ける。LAN だけなら :80 のまま
PYXIS_SITE_ADDRESS=:80

# ホスト側で開く http と https のポート。80 と 443 がほかに使われているなら別の番号にする
PYXIS_HTTP_PORT=80
PYXIS_HTTPS_PORT=443

# 録画をあとからエンコードするときのエンコーダー。Software、Vaapi、Nvenc のどれか (Vaapi と Nvenc は GPU を渡したとき)
CARINA_ENCODINGS_PREFER=Software

# ライブと録画再生をリアルタイムでトランスコードするときのエンコーダー。Software、Vaapi、Nvenc のどれか (Vaapi と Nvenc は GPU を渡したとき)
CARINA_TRANSCODING_PREFER=Software

# VAAPI で使う GPU の render ノード
CARINA_RENDER_NODE=/dev/dri/renderD128
